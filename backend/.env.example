# Backend .env - copy this to .env.local for local development
# For production (Supabase), set DATABASE_URL in your hosting platform

# ── PostgreSQL (optional) ────────────────────────────────────────────────────
# Leave blank to use local SQLite. For PostgreSQL, replace this with the
# connection URI from your database provider.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@HOST:5432/postgres

# ── Local SQLite (development only) ──────────────────────────────────────────
# Leave DATABASE_URL unset to use SQLite automatically
# DB_PATH=./water.sqlite

# ── JWT Secret ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── App Port (local) ─────────────────────────────────────────────────────────
PORT=4000

# ── Optional Chapa checkout handoff ──────────────────────────────────────────
# CHAPA_CHECKOUT_URL=https://checkout.example.com
