# Copy to .env for local development. Never commit the real .env file.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# NODE_ENV=production

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production (the server refuses to start without it).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN_SECONDS=604800

# Shared key the IoT meters send in the `x-device-key` header.
# Open in development when unset, rejected in production when unset.
DEVICE_API_KEY=

# Comma-separated browser origins allowed by CORS (unset = allow all, development only)
# CORS_ORIGINS=https://admin.example.com,https://app.example.com

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the local SQLite file below.
DATABASE_URL=
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DB_SSL=require        # disable | require (default, no cert check) | verify
# DB_SYNC=true          # PostgreSQL only: create/update tables once, then remove
DB_PATH=./water.sqlite

# ── Payments (optional) ─────────────────────────────────────────────────────
# CHAPA_CHECKOUT_URL=https://checkout.example.com
