# Backend .env - copy this to .env.local for local development
# For production (Supabase), set DATABASE_URL in your hosting platform

# ── Supabase / PostgreSQL (production) ───────────────────────────────────────
# Get this from: Supabase Dashboard > Project > Settings > Database > Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Local SQLite (development only) ──────────────────────────────────────────
# Leave DATABASE_URL unset to use SQLite automatically
# DB_PATH=./water.sqlite

# ── JWT Secret ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── App Port (local) ─────────────────────────────────────────────────────────
PORT=4000
